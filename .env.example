# --- Proveedor de texto (primario) ---
# deepseek | nvidia | anthropic | openai | groq | openrouter | ollama | openai_compat
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Anthropic (solo si LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Fallback (opcional; se intenta si el primario falla) ---
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# LLM_FALLBACK_BASE_URL=

# --- Tercer nivel (opcional) ---
# LLM_TERTIARY_PROVIDER=nvidia
# LLM_TERTIARY_API_KEY=
# LLM_TERTIARY_MODEL=
# LLM_TERTIARY_BASE_URL=

# --- Voz: transcripción (STT) ---
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
STT_IDIOMA=es
# Pista de vocabulario para el transcriptor (opcional; hay un default en config.py)
# STT_PROMPT=

# --- Voz: síntesis en la nube (TTS, opcional) — Azure AI Speech ---
# Vacío = POST /voz/sintetizar responde 503 y la app usa la voz del teléfono.
# Clave y región: Azure Portal -> recurso "Speech" (capa gratis F0) -> Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Voz neuronal por defecto (sólo voces es-XX-...Neural)
TTS_VOZ=es-PE-CamilaNeural

# --- Otros ---
GOOGLE_PLACES_API_KEY=
ALLOWED_ORIGINS=*
ENVIRONMENT=development

# --- Supabase ---
# SUPABASE_URL: https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: clave service_role. Ignora RLS: NUNCA en la app móvil ni en el repo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
