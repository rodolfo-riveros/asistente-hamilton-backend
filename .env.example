# --- Proveedor de texto (primario) ---
# deepseek | nvidia | anthropic | openai | groq | openrouter | ollama | openai_compat
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Anthropic (solo si LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Fallback (opcional; se intenta si el primario falla) ---
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# LLM_FALLBACK_BASE_URL=

# --- Tercer nivel (opcional) ---
# LLM_TERTIARY_API_KEY=
# LLM_TERTIARY_MODEL=
# LLM_TERTIARY_BASE_URL=

# --- Voz: transcripción (STT) ---
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
STT_IDIOMA=es

# --- Otros ---
GOOGLE_PLACES_API_KEY=
ALLOWED_ORIGINS=*
ENVIRONMENT=development

# --- Supabase ---
# SUPABASE_URL: https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: clave service_role. Ignora RLS: NUNCA en la app móvil ni en el repo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
